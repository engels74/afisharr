{
	"name": "afisharr-web",
	"description": "The Afisharr single-page interface, prerendered and embedded in the binary",
	"version": "0.1.0",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
