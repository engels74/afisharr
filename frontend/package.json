		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/bun": "1.3.14",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "4.1.10",
		"playwright": "^1.62.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"typescript": "~6",
		"unocss": "^66.7.5",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.30.0",
		"bits-ui": "^2.18.1",
